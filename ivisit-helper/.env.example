# =============================================================================
# iVisit Helper - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values before starting the helper.
# =============================================================================

# Server port
HELPER_SERVER_PORT=8765

# CORS (comma-separated origins allowed to call the helper)
HELPER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Tesseract OCR data path (Windows default shown)
# Override if Tesseract is installed elsewhere or you are on macOS/Linux.
TESSERACT_DATAPATH=C:\\Program Files\\Tesseract-OCR\\tessdata

# Backend URL
HELPER_BACKEND_URL=http://localhost:8080

# Station binding
HELPER_STATION_ID=1
HELPER_STATION_CONFIG_PATH=station-config.properties
HELPER_POLL_DELAY_MS=10000

# OCR.space API (get a free key at https://ocr.space/)
OCRSPACE_API_KEY=
OCRSPACE_API_URL=https://api.ocr.space/parse/image

# Logging
LOG_LEVEL=INFO

# File upload limits
MULTIPART_MAX_FILE_SIZE=50MB
MULTIPART_MAX_REQUEST_SIZE=100MB
