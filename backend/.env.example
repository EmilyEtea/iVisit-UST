# =============================================================================
# iVisit Backend - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values before starting the backend.
# =============================================================================

# Spring profile
BACKEND_PROFILE=prod

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ivisitdb
DB_USERNAME=root
DB_PASSWORD=
DB_USE_SSL=false
DB_TIMEZONE=UTC

# App URLs
APP_FRONTEND_BASE_URL=https://yourdomain.com
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Server port
BACKEND_SERVER_PORT=8080

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# File storage
FILE_UPLOAD_DIR=uploads/

# H2 console (disable in production)
H2_CONSOLE_ENABLED=false
H2_CONSOLE_PATH=/h2-console

# Mail (required for email verification and password reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Admin seeder (set strong values for production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=Admin

# 2FA issuer label shown in authenticator apps
APP_2FA_ISSUER=iVisitUST

# Error response detail (restrict in production)
ERROR_INCLUDE_MESSAGE=never
ERROR_INCLUDE_BINDING=never
ERROR_INCLUDE_STACKTRACE=never

# Logging
LOG_LEVEL=WARN
LOG_FILE_PATH=logs
